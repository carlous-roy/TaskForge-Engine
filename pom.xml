<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.taskforge</groupId>
    <artifactId>taskforge-parent</artifactId>
    <version>1.1.0</version>
    <packaging>pom</packaging>
    <name>TaskForge</name>
    <description>Distributed report generation on Spring Boot, SQS, DynamoDB and S3</description>

    <modules>
        <module>taskforge-common</module>
        <module>taskforge-test-support</module>
        <module>taskforge-dashboard</module>
        <module>taskforge-api</module>
        <module>taskforge-worker</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <aws.sdk.version>2.55.0</aws.sdk.version>
        <!-- Integration tests are named *IT and run by failsafe during `mvn verify`. They need
             Docker (Testcontainers starts LocalStack) or AWS_ENDPOINT_OVERRIDE pointing at a running
             emulator. Pass -DskipITs to run only the unit tests. -->
        <skipITs>false</skipITs>
        <skipTests>false</skipTests>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.taskforge</groupId>
                <artifactId>taskforge-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.taskforge</groupId>
                <artifactId>taskforge-dashboard</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.taskforge</groupId>
                <artifactId>taskforge-test-support</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
